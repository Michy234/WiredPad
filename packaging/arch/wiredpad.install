post_install() {
    udevadm control --reload-rules
    udevadm trigger --action=change --subsystem-match=misc --sysname-match=uinput
    printf '%s\n' 'WiredPad: EVDI is managed by DKMS. Check the DKMS transaction output for build errors.' 'Open WiredPad from your application menu. EVDI will load automatically on next boot.'
}
post_upgrade() { post_install; }
post_remove() { udevadm control --reload-rules; }
